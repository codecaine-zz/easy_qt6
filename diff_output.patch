+  if (!info || !info->app_delegate || !name) return strdup("[]");
+  AppDelegate *delegate = (AppDelegate *)info->app_delegate;
+  NSString *nameStr = [nsstring(name) lowercaseString];
+  __block NSString *json = @"[]";
+  void (^runBlock)(void) = ^{
